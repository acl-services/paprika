{
  "name": "@paprika/paprika",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "build:translations": "yarn workspace @paprika/l10n build:translations",
    "cleanup": "yarn rimraf packages/*/lib",
    "cypress:ci": "run-p --race storybook cypress:run",
    "cypress:dev": "run-p --race storybook cypress:open",
    "cypress:open": "cypress open",
    "cypress:run": "wait-on http://localhost:9009/iframe.html && cypress run --browser chrome",
    "generateReadMe": "node scripts/readmeFiles.mjs",
    "generateTypeDefinitionsForJS": "node scripts/typesFiles.mjs",
    "generateDocStories": "node scripts/docStories.js",
    "jest:watch": "yarn jest --watch",
    "license": "node packages/helpers/src/license.js",
    "lint": "oxlint packages --report-unused-disable-directives",
    "lint:fix": "yarn lint --fix",
    "lint:jss": "stylelint './packages/**/src/**/*.styles.js'",
    "pestle": "node scripts/pestle/mainCLI.js",
    "build:icons": "yarn workspace @paprika/icon transpile",
    "build:pretranspile": "yarn workspace @paprika/icon pretranspile && yarn workspace @paprika/l10n pretranspile && yarn workspace @paprika/tokens pretranspile",
    "build:packages": "yarn build:pretranspile && yarn transpile",
    "build:types": "yarn workspace @paprika/tokens transpile:types && yarn workspace @paprika/helpers transpile:types && yarn workspace @paprika/stylers transpile:types && yarn workspace @paprika/link transpile:types && yarn workspace @paprika/resize-detector transpile:types && yarn workspace @paprika/data-table transpile:types",
    "build:repo": "yarn cleanup && yarn build:packages && yarn generateTypeDefinitionsForJS && yarn build:types && yarn generateReadMe",
    "prepare:esm": "yarn transpile:esm && yarn workspaces foreach --all --topological run transpile:esm:types",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "storybook": "run-p storybook:start storybook:uploadserver",
    "storybook:build": "yarn build:packages && node scripts/runStorybook.js build-storybook -s ./.storybook/public -c .storybook -o storybook-dist",
    "storybook:screener": "yarn build:packages && screener-storybook --conf screener.config.js",
    "storybook:start": "yarn build:packages && node scripts/runStorybook.js start-storybook -s ./.storybook/public -p 9009 -c .storybook",
    "storybook:uploadserver": "node scripts/uploaderServer",
    "storybook:startWithoutHMR": "yarn build:packages && DISABLE_HMR=true node scripts/runStorybook.js start-storybook -s ./.storybook/public -p 9009 -c .storybook",
    "test": "jest --passWithNoTests",
    "test:a11y": "echo 'Axe will run on this command'",
    "test:debug": "node --inspect node_modules/.bin/jest --runInBand",
    "transpile": "node scripts/transpile.js",
    "transpile:esm": "node scripts/transpile.js --esm",
    "validate:ts": "tsc",
    "paprika-status": "node scripts/status/paprika-status",
    "paprika-status:a11y": "run-p --race storybook:startWithoutHMR getA11yStatus",
    "getA11yStatus": "wait-on http://localhost:9009/iframe.html && node --max-old-space-size=8192 scripts/status/paprika-status--a11y"
  },
  "dependencies": {
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@changesets/cli": "^2.31.1",
    "legally": "^3.5.10",
    "pascal-case": "^3.1.2",
    "react-json-tree": "^0.20.0",
    "shelljs": "^0.10.0"
