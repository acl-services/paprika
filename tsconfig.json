{
  "include": ["./packages"],
  "exclude": ["node_modules", "**/node_modules", "**/stories/**", "**/tests/**", "**/*.stories.*", "**/*.test.*"],
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "jsx": "react",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true
  }
}
