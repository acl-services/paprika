{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true
    },
    "transform": {
      "react": {
        "runtime": "classic"
      }
    },
    "target": "es2018",
    "experimental": {
      "cacheRoot": "../../node_modules/.cache/swc",
      "plugins": [["@swc/plugin-styled-components", { "displayName": true, "ssr": true }]]
    }
  },
  "module": {
    "type": "es6"
  },
  "exclude": [
    ".*\\.d\\.ts$",
    ".*\\.test\\.",
    ".*\\.spec\\.",
    ".*\\.stories\\.",
    "node_modules"
  ]
}
